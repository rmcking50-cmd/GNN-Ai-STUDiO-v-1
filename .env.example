# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT Authentication Secret for GNN AI OS permission validation
JWT_SECRET=

# Google Cloud SQL (PostgreSQL) Configuration for asia-southeast1 (Singapore)
CLOUDSQL_PROJECT_ID=gen-lang-client-0808966802
CLOUDSQL_REGION=asia-southeast1
CLOUDSQL_INSTANCE_NAME=gnn-studio-db-asia-se1
CLOUDSQL_DATABASE=gnn_studio
CLOUDSQL_USER=gnn_admin
CLOUDSQL_PASSWORD=
CLOUDSQL_HOST=127.0.0.1
CLOUDSQL_PORT=5432
CLOUDSQL_SOCKET_PATH=

